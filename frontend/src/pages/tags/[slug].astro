---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getPosts, getTags } from '../../lib/api';

const { slug } = Astro.params;
const [data, tags] = await Promise.all([getPosts({ tag: slug, pageSize: 50 }), getTags()]);
const tag = tags.find(item => item.slug === slug);
---
<BaseLayout title={`#${tag?.name || slug} · 漂流笔记`} description={`标签 ${tag?.name || slug} 下的全部文章。`}>
  <section class="page-hero"><div class="shell"><div class="eyebrow">Topic collection</div><h1>#{tag?.name || slug}</h1><p>这个话题下共有 {data.pagination.total} 篇文章。<a class="text-link" href="/tags">查看全部话题 →</a></p></div></section>
  <section class="page-content"><div class="shell">{data.items.length ? <div class="post-grid">{data.items.map(post => <PostCard post={post} />)}</div> : <EmptyState title="这个话题还没有文章" />}</div></section>
</BaseLayout>
