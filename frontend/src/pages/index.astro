---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import EmptyState from '../components/EmptyState.astro';
import { getPosts, getTags, type Post, type Tag } from '../lib/api';

let posts: Post[] = [];
let tags: Tag[] = [];
let loadError = '';
try {
  const [postData, tagData] = await Promise.all([getPosts({ pageSize: 7 }), getTags()]);
  posts = postData.items;
  tags = tagData;
} catch (error) {
  loadError = error instanceof Error ? error.message : '内容暂时无法加载';
}
const featured = posts[0];
const latest = posts.slice(1);
---
<BaseLayout>
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">A quiet place on the internet</div>
        <h1>在喧嚣之外，<br />保留<em>思考</em>的余地。</h1>
        <p class="hero-description">这里是我的数字花园。写下技术实践中的得失，记录阅读时偶遇的句子，也收藏那些值得被记住的日常。</p>
        <div class="hero-buttons">
          <a class="button" href="/posts">开始阅读<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></a>
          <a class="text-link" href="/about">关于这个角落<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></a>
        </div>
        <div class="hero-note">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3v18M3 12h18"/></svg>不定期更新，长期维护</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V4H6.5A2.5 2.5 0 0 0 4 6.5v13Z"/></svg>文章支持 RSS 订阅</span>
        </div>
      </div>
      {featured ? (
        <div class="featured-wrap">
          <a class="featured-card" href={`/posts/${featured.slug}`}>
            <div class="featured-image"><img src={featured.cover_image || '/covers/default.svg'} alt={featured.title} /></div>
            <span class="featured-label">FEATURED · 最新发布</span>
            <div class="featured-content">
              <div class="post-meta"><time>{new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(featured.published_at!))}</time><span class="dot"></span><span>{featured.tags[0]?.name || '随笔'}</span></div>
              <h2>{featured.title}</h2>
              <p>{featured.excerpt}</p>
              <div class="featured-footer"><div class="featured-tags">{featured.tags.slice(0, 2).map(tag => <span>{tag.name}</span>)}</div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></div>
            </div>
          </a>
        </div>
      ) : <EmptyState title="博客还没有文章" message={loadError || '发布第一篇文章后，它会出现在这里。'} />}
    </div>
  </section>

  {latest.length > 0 && (
    <section class="home-content">
      <div class="shell">
        <div class="section-heading">
          <div><div class="eyebrow">Recently written</div><h2>最近写下</h2></div>
          <a class="text-link" href="/posts">查看全部文章<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></a>
        </div>
        <div class="content-grid">
          <div class="post-list">{latest.slice(0, 5).map(post => <PostRow post={post} />)}</div>
          <aside class="sidebar">
            <section class="sidebar-block">
              <h3 class="sidebar-title">关于作者</h3>
              <div class="author-mini"><div class="avatar">漂</div><div><strong>漂流笔记</strong><span>Developer & occasional writer</span></div></div>
              <p>一名喜欢把复杂问题讲清楚的开发者。相信慢工、长期主义，以及文字的力量。</p>
              <a class="text-link" href="/about">更多关于我 →</a>
            </section>
            <section class="sidebar-block">
              <h3 class="sidebar-title">常写的话题</h3>
              <div class="tag-cloud">{tags.slice(0, 8).map(tag => <a href={`/tags/${tag.slug}`}>#{tag.name}<sup>{tag.post_count}</sup></a>)}</div>
            </section>
            <section class="quote-card">
              <blockquote>“写作不是为了表达已经知道的事，而是为了发现自己真正在想什么。”</blockquote>
              <cite>— 摘录于某个安静的夜晚</cite>
            </section>
          </aside>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
