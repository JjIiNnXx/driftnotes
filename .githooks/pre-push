#!/usr/bin/env bash
# Block direct pushes to main locally, so the rejection happens before the push.
# GitHub branch protection enforces the same rule server-side.
set -euo pipefail

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    cat >&2 <<'EOF'
Direct pushes to main are blocked by the local Git hook.

Create a feature_<short-name> branch, push it, and open a PR targeting main.
GitHub branch protection blocks direct pushes to main as well; --no-verify
only skips this local check and the server will still reject the push.
EOF
    exit 1
  fi
done
